                        "text/html": "<div><div style = \"float: left;\"><span>9×4 DataFrame</span></div><div style = \"clear: both;\"></div></div><div class = \"data-frame\" style = \"overflow-x: scroll;\"><table class = \"data-frame\" style = \"margin-bottom: 6px;\"><thead><tr class = \"columnLabelRow\"><th class = \"stubheadLabel\" style = \"font-weight: bold; text-align: right;\">Row</th><th style = \"text-align: left;\">Source</th><th style = \"text-align: left;\">Target</th><th style = \"text-align: left;\">Probability</th><th style = \"text-align: left;\">qvalue</th></tr><tr class = \"columnLabelRow\"><th class = \"stubheadLabel\" style = \"font-weight: bold; text-align: right;\"></th><th title = \"String\" style = \"text-align: left;\">String</th><th title = \"String\" style = \"text-align: left;\">String</th><th title = \"Float64\" style = \"text-align: left;\">Float64</th><th title = \"Float64\" style = \"text-align: left;\">Float64</th></tr></thead><tbody><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">1</td><td style = \"text-align: left;\">hsa-miR-345-5p</td><td style = \"text-align: left;\">SLC25A29</td><td style = \"text-align: right;\">0.999814</td><td style = \"text-align: right;\">0.00018602</td></tr><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">2</td><td style = \"text-align: left;\">hsa-let-7b-5p</td><td style = \"text-align: left;\">PRR34-AS1</td><td style = \"text-align: right;\">0.999749</td><td style = \"text-align: right;\">0.000218495</td></tr><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">3</td><td style = \"text-align: left;\">hsa-miR-574-5p</td><td style = \"text-align: left;\">FAM114A1</td><td style = \"text-align: right;\">0.999349</td><td style = \"text-align: right;\">0.000362817</td></tr><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">4</td><td style = \"text-align: left;\">hsa-miR-574-3p</td><td style = \"text-align: left;\">FAM114A1</td><td style = \"text-align: right;\">0.999102</td><td style = \"text-align: right;\">0.000496625</td></tr><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">5</td><td style = \"text-align: left;\">hsa-let-7b-5p</td><td style = \"text-align: left;\">MIRLET7BHG</td><td style = \"text-align: right;\">0.998505</td><td style = \"text-align: right;\">0.000696205</td></tr><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">6</td><td style = \"text-align: left;\">hsa-miR-574-5p</td><td style = \"text-align: left;\">TLR10</td><td style = \"text-align: right;\">0.894855</td><td style = \"text-align: right;\">0.0181044</td></tr><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">7</td><td style = \"text-align: left;\">hsa-miR-1270-2-5p</td><td style = \"text-align: left;\">ZNF826P</td><td style = \"text-align: right;\">0.889367</td><td style = \"text-align: right;\">0.0313227</td></tr><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">8</td><td style = \"text-align: left;\">hsa-miR-642a-5p</td><td style = \"text-align: left;\">GIPR</td><td style = \"text-align: right;\">0.779278</td><td style = \"text-align: right;\">0.0549977</td></tr><tr class = \"dataRow\"><td class = \"rowLabel\" style = \"font-weight: bold; text-align: right;\">9</td><td style = \"text-align: left;\">hsa-miR-181c-5p</td><td style = \"text-align: left;\">C19orf53</td><td style = \"text-align: right;\">0.749367</td><td style = \"text-align: right;\">0.0767349</td></tr></tbody></table></div>",
                        "text/latex": "\\begin{tabular}{r|cccc}\n\t& Source & Target & Probability & qvalue\\\\\n\t\\hline\n\t& String & String & Float64 & Float64\\\\\n\t\\hline\n\t1 & hsa-miR-345-5p & SLC25A29 & 0.999814 & 0.00018602 \\\\\n\t2 & hsa-let-7b-5p & PRR34-AS1 & 0.999749 & 0.000218495 \\\\\n\t3 & hsa-miR-574-5p & FAM114A1 & 0.999349 & 0.000362817 \\\\\n\t4 & hsa-miR-574-3p & FAM114A1 & 0.999102 & 0.000496625 \\\\\n\t5 & hsa-let-7b-5p & MIRLET7BHG & 0.998505 & 0.000696205 \\\\\n\t6 & hsa-miR-574-5p & TLR10 & 0.894855 & 0.0181044 \\\\\n\t7 & hsa-miR-1270-2-5p & ZNF826P & 0.889367 & 0.0313227 \\\\\n\t8 & hsa-miR-642a-5p & GIPR & 0.779278 & 0.0549977 \\\\\n\t9 & hsa-miR-181c-5p & C19orf53 & 0.749367 & 0.0767349 \\\\\n\\end{tabular}\n"
